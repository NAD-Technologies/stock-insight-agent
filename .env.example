# All optional. Without them the app still works (template narrative + lexicon news sentiment).
ANTHROPIC_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
FRED_API_KEY=
CORS_ORIGINS=http://localhost:5173

# Alternative to Claude: NVIDIA open models (Nemotron) via NVIDIA NIM (free key at build.nvidia.com)
NVIDIA_API_KEY=
# LLM_PROVIDER=nvidia            # anthropic | nvidia | openai (openai = any compatible server, e.g. Ollama)
# LLM_MODEL=                     # e.g. a Nemotron model id; local Ollama: LLM_PROVIDER=openai LLM_BASE_URL=http://localhost:11434/v1

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application";
# add http://localhost:5173 and your public URL under Authorized JavaScript origins). Without it only guest mode works.
GOOGLE_CLIENT_ID=
SESSION_SECRET=                  # any long random string; keeps logins valid across restarts

# Comma-separated Google emails allowed to open the Admin page
ADMIN_EMAILS=
# Where the SQLite file (users, ticker views, feedback) lives. Use a persistent path in production.
# DATA_DIR=

# Persistent storage (recommended in production): a Postgres connection string, e.g. from free Neon or Supabase.
# When empty the app falls back to a local SQLite file, which Render wipes on every redeploy.
DATABASE_URL=
